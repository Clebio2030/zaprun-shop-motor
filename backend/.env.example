# ─────────────────────────────────────────────────────────────────────────────
#  Motor ZapRun Shop — configuração LOCAL da máquina do cliente
# ─────────────────────────────────────────────────────────────────────────────
#
#  ⚠️  ESTE ARQUIVO É PRESERVADO PELO UPDATER.
#
#  Isso quer dizer que o que você escrever aqui NUNCA mais muda sozinho — nem
#  com release nova. Por isso ele carrega SÓ o que é legitimamente por-máquina:
#  credencial, caminho do banco e token.
#
#  Ritmo do cron e tamanho do lote NÃO ficam aqui: vêm do servidor a cada ciclo
#  (GET /erp/handshake). É assim que mudamos o comportamento de 100 clientes de
#  uma vez, sem RDP em nenhum.
#
#  Copie para `.env` e preencha. O instalador (INSTALAR.bat) faz isso sozinho.

# ── Firebird do ERP (local) ──────────────────────────────────────────────────
FB_HOST=127.0.0.1
FB_PORT=3050
FB_DATABASE=C:\Sistemas\Banco\DADOS.FDB
FB_USER=SYSDBA
FB_PASSWORD=masterkey
FB_CHARSET=WIN1252

# ── ZapRun ───────────────────────────────────────────────────────────────────
# Token gerado no painel do ZapRun (Integrações → ERP). Começa com "zrerp_".
# É ele que diz de qual empresa é o catálogo — não erre o cliente.
ZAPRUN_TOKEN=

# Sem barra no final.
ZAPRUN_API_URL=https://dev.zaprun.com.br

# ── Servidor local ───────────────────────────────────────────────────────────
# Escuta só em 127.0.0.1.
#
# 3002, e NÃO 3001: o Motor de Orçamentos usa a 3001 e as duas máquinas-alvo
# são a mesma. Com as duas na mesma porta, o segundo serviço a subir morre com
# EADDRINUSE e o updater do primeiro passa a fazer health check no processo
# errado. Se mudar, ajuste também o healthUrl em updater/updater-config.json.
PORT=3002

# ── Ajustes finos (raramente necessários) ────────────────────────────────────
# FB_POOL_SIZE=3
# FB_QUERY_TIMEOUT=300000
# ZAPRUN_HTTP_TIMEOUT=120000
# ZAPRUN_MAX_BYTES=3000000
